# Python cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.so
*.egg
*.egg-info

# Tests
**/tests/
**/test_*.py

# Development files
.git
.gitignore
notebooks/
docs/

# NOTE: pyproject.toml and uv.lock are intentionally NOT ignored — the
# extension ships them so uv can resolve/build the locked dependency
# environment at runtime (see run_server.sh / build-extension.sh).

# IDE
.vscode
.idea
*.swp
*.swo
.DS_Store

# Build artifacts
build/
dist/
